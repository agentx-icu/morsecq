# Generated by tool/release/generate_distribution_metadata.py from GitHub {{TAG}}.
# Native build/install NOT YET TESTED. Validate before any Store submission.
# core24 matches Ubuntu 24.04, which builds the Linux release archive.
# GNOME extension: https://ubuntu.com/docs/snapcraft/9/reference/extensions/gnome-extension/
name: morsecq
base: core24
version: '{{VERSION}}'
summary: Account-free offline Morse code trainer
description: |
  MorseCQ is an account-free, offline Morse code trainer. Progress and
  recordings stay on the device.
license: GPL-3.0-only
icon: morsecq.png
grade: devel
confinement: strict
platforms:
  amd64:
    build-on: [amd64]
    build-for: [amd64]

apps:
  morsecq:
    extensions: [gnome]
    command: bin/morsecq-launcher
    desktop: usr/share/applications/morsecq.desktop
    plugs:
      - audio-playback
      - audio-record
      - home

parts:
  morsecq:
    plugin: nil
    source: https://github.com/agentx-icu/morsecq/releases/download/{{TAG}}/{{LINUX_ASSET}}
    source-checksum: "sha256/{{LINUX_SHA256}}"
    # GTK/GLib/GPU runtime and desktop setup come from the GNOME extension.
    # These Noble packages cover native audio/tray dependencies; use ldd and
    # real launch/audio/tray tests to audit this list before promoting grade.
    stage-packages:
      - libasound2t64
      - libpulse0
      - libayatana-appindicator3-1
    override-build: |
      set -eux
      install -d "$CRAFT_PART_INSTALL/usr/lib/morsecq"
      if [ -f ./morsecq ] && [ -x ./morsecq ]; then bundle=.; elif [ -x ./morsecq/morsecq ]; then bundle=./morsecq; else echo "MorseCQ bundle executable not found" >&2; exit 1; fi
      cp -a "$bundle"/. "$CRAFT_PART_INSTALL/usr/lib/morsecq/"
      install -Dm755 "$CRAFT_PROJECT_DIR/morsecq-launcher" "$CRAFT_PART_INSTALL/bin/morsecq-launcher"
      install -Dm644 "$CRAFT_PROJECT_DIR/morsecq.png" "$CRAFT_PART_INSTALL/usr/share/icons/hicolor/256x256/apps/morsecq.png"
      install -d "$CRAFT_PART_INSTALL/usr/share/applications"
      cat > "$CRAFT_PART_INSTALL/usr/share/applications/morsecq.desktop" <<'DESKTOP'
      [Desktop Entry]
      Name=MorseCQ
      Comment=Account-free offline Morse code trainer
      Exec=morsecq
      Icon=morsecq
      Terminal=false
      Type=Application
      Categories=Education;AudioVideo;
      DESKTOP
