{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt (QR scan of a friend's Tox ID). Keep the English value in sync with Info.plist.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ verwendet die Kamera nur, um den Tox-ID-QR-Code eines Freundes zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ uses the camera only to scan a friend's Tox ID QR code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ usa la cámara solo para escanear el código QR del ID de Tox de un amigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ utilise l'appareil photo uniquement pour scanner le QR code de l'identifiant Tox d'un ami."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ はフレンドの Tox ID の QR コードを読み取るときだけカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ는 친구의 Tox ID QR 코드를 스캔할 때만 카메라를 사용합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MorseCQ usa a câmera apenas para ler o código QR do ID Tox de um amigo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ использует камеру только для сканирования QR-кода Tox ID друга."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ 仅在扫描好友的 Tox ID 二维码时使用相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ 僅在掃描好友的 Tox ID QR 碼時使用相機。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Microphone permission prompt (Listen tab: decode Morse from audio). Keep the English value in sync with Info.plist.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ verwendet das Mikrofon nur, um Morsezeichen zu dekodieren, die du in der Nähe abspielst oder gibst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ uses the microphone only to decode Morse code you play or key nearby."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ usa el micrófono solo para decodificar el código Morse que reproduces o manipulas cerca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ utilise le micro uniquement pour décoder le morse que vous jouez ou manipulez à proximité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ は近くで再生または打鍵されたモールス符号を解読するためだけにマイクを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ는 근처에서 재생하거나 타전한 모스 부호를 해독할 때만 마이크를 사용합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MorseCQ usa o microfone apenas para decodificar o código Morse que você reproduz ou transmite por perto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ использует микрофон только для декодирования азбуки Морзе, которую вы воспроизводите или передаёте рядом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ 仅使用麦克风来解码你在附近播放或拍发的摩尔斯电码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MorseCQ 僅使用麥克風來解碼你在附近播放或拍發的摩斯電碼。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
