/* Japanese permission purpose strings for the NS*UsageDescription
   keys in Info.plist. The product name MorseCQ stays untranslated;
   other terms follow lib/l10n/app_*.arb. Every NS*UsageDescription key
   needs an entry here (test/i18n/platform_locales_test.dart). */


/* Shown when MorseCQ first asks for the microphone (decoding Morse from audio). */
"NSMicrophoneUsageDescription" = "MorseCQ はマイクを、近くで再生または打鍵されたモールス符号を解読するためだけに使用します。";
