/* Portuguese (Brazil) permission purpose strings for the NS*UsageDescription
   keys in Info.plist. The product name MorseCQ stays untranslated;
   other terms follow lib/l10n/app_*.arb. Every NS*UsageDescription key
   needs an entry here (test/i18n/platform_locales_test.dart). */

/* Shown when MorseCQ first asks for the camera (scanning a Tox ID QR code). */
"NSCameraUsageDescription" = "O MorseCQ usa a câmera apenas para ler o código QR do Tox ID de um amigo.";

/* Shown when MorseCQ first asks for the microphone (decoding Morse from audio). */
"NSMicrophoneUsageDescription" = "O MorseCQ usa o microfone apenas para decodificar o código Morse que você reproduz ou transmite por perto.";
