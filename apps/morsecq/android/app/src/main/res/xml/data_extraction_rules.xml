<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): nothing of MorseCQ leaves the device through
     Google cloud backup or device-to-device transfer. The app data holds the
     Tox identity (profile, history, drafts, pending friend requests); the
     user moves it deliberately with the in-app backup file instead.
     Referenced by android:dataExtractionRules in AndroidManifest.xml; the
     pre-12 equivalent is backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
